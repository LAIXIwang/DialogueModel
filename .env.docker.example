# ============ Docker 部署环境变量（复制为 .env.docker 后按需修改）============
# 部署命令：docker compose --env-file .env.docker up -d --build

# 对外端口
WEB_PORT=80

# MySQL（容器内使用，不对外暴露）
MYSQL_PASSWORD=123456

# JWT 密钥（生产环境务必改为随机长字符串，如 openssl rand -hex 32）
JWT_SECRET=please-change-this-secret-in-production

# 令牌有效期
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# 单用户每分钟 AI 请求上限（管理后台可在线调整）
RATE_LIMIT_PER_MINUTE=10
# 新用户默认每日 token 配额
DEFAULT_DAILY_QUOTA=100000

# 模型接入默认值（管理后台「模型接入」可在线修改）
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
UPSTREAM_PROTOCOL=openai
UPSTREAM_MODEL=deepseek-chat
