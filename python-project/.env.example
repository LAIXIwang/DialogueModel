# ============ Dialogue BFF 配置示例 ============
# 复制为 .env 后按需修改

# ---- 服务 ----
APP_NAME=Dialogue BFF
APP_ENV=dev                      # dev | prod（prod 下必须配置 CLIENT_API_KEYS）
HOST=127.0.0.1
PORT=8000

# ---- 鉴权：浏览器端客户端令牌（逗号分隔多个，轮换时新旧并存）----
CLIENT_API_KEYS=sk-bff-demo-key

# ---- 上游自建模型 API（生产环境务必使用 https://）----
UPSTREAM_BASE_URL=http://127.0.0.1:9190/v1
UPSTREAM_API_KEY=
UPSTREAM_PROTOCOL=openai          # openai | llamacpp
UPSTREAM_MODEL=dialogue-model

# ---- 上游超时（秒）----
CONNECT_TIMEOUT=10
READ_TIMEOUT=300
WRITE_TIMEOUT=30

# ---- 限流 ----
RATE_LIMIT_IP_PER_MINUTE=30
RATE_LIMIT_SESSION_PER_MINUTE=15

# ---- 会话 ----
SESSION_TTL_MINUTES=1440
MAX_HISTORY_MESSAGES=40

# ---- SSE ----
KEEPALIVE_SECONDS=15

# ---- CORS（逗号分隔；经 Vite 代理部署时可留空）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HEADERS=true

# ---- 邮件（找回密码验证码；不配置时开发模式下验证码打印到服务端日志）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
SMTP_STARTTLS=false
